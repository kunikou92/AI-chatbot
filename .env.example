# Gemini API Key
# https://aistudio.google.com/app/apikey から取得してください
GEMINI_API_KEY=your_gemini_api_key_here

# アプリケーション設定
NEXT_PUBLIC_APP_NAME=AI Chatbot
NEXT_PUBLIC_API_TIMEOUT=30000

# API設定
# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-pro
GEMINI_API_MODEL=gemini-1.5-pro
GEMINI_API_VERSION=v1beta
